<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>VSBot</AssemblyName>
    <RootNamespace>VSBot</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <OutputPath>..\build\bot</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="VintagestoryLib"><HintPath>$(VS_SERVER)\VintagestoryLib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VintagestoryAPI"><HintPath>$(VS_SERVER)\VintagestoryAPI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
